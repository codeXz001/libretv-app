{
  "name": "libretv-app",
  "version": "1.0.0",
  "private": true,
  "description": "LibreTV Android App，基于 Capacitor 打包",
  "scripts": {
    "cap": "cap",
    "sync": "cap sync",
    "sync:web": "node scripts/sync-web.mjs",
    "android": "cap open android",
    "build:android": "cap sync && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}